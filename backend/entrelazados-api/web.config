<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<system.webServer>

		<!-- 1. ACCESO PÚBLICO LIBRE SIN AUTENTICACIÓN -->
		<security>
			<authentication>
				<anonymousAuthentication enabled="true" />
				<basicAuthentication enabled="false" />
				<windowsAuthentication enabled="false" />
			</authentication>
			<requestFiltering>
				<hiddenSegments>
					<add segment="node_modules" />
					<add segment="iisnode" />
					<add segment=".env" />
				</hiddenSegments>
			</requestFiltering>
		</security>

		<!-- 2. REGISTRO DEL HANDLER DE IISNODE (SIN REMOVER STATICFILE) -->
		<handlers>
			<add name="iisnode" path="index.js" verb="*" modules="iisnode" />
		</handlers>

		<!-- 3. CONFIGURACIÓN DEL ENTORNO IISNODE -->
		<iisnode
		  loggingEnabled="true"
		  logDirectory="iisnode"
		  debuggingEnabled="false"
		  devErrorsEnabled="false"
		  nodeProcessCommandLine="node.exe" />

		<!-- 4. REGLAS DE REESCRITURA DE URL -->
		<rewrite>
			<rules>
				<!-- Ignorar peticiones a logs de depuración -->
				<rule name="NodeInspector" stopProcessing="true">
					<match url="^index.js\/debug[\/]?" />
				</rule>

				<!-- Página de inicio: la raíz del sitio muestra preview.html -->
				<rule name="Inicio" stopProcessing="true">
					<match url="^$" />
					<action type="Rewrite" url="public/preview.html" />
				</rule>

				<!-- Los archivos estáticos se sirven SOLO desde la carpeta "public".
				     Así index.js, .env y web.config nunca se pueden descargar. -->
				<rule name="StaticContent" stopProcessing="true">
					<match url="^(?!index\.js)(.*\.(html|css|js|png|jpg|jpeg|gif|ico|svg|webp|woff|woff2|ttf|eot))$" ignoreCase="true" />
					<action type="Rewrite" url="public/{R:1}" />
				</rule>

				<!-- Redirigir peticiones dinámicas y API a index.js -->
				<rule name="DynamicContent">
					<conditions>
						<add input="{REQUEST_FILENAME}" matchType="IsFile" negate="True" />
					</conditions>
					<action type="Rewrite" url="index.js" />
				</rule>
			</rules>
		</rewrite>

		<directoryBrowse enabled="false" />

	</system.webServer>
</configuration>