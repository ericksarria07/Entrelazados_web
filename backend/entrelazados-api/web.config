<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<system.webServer>

		<!-- 1. ACCESO PÚBLICO LIBRE SIN AUTENTICACIÓN -->
		<security>
			<authentication>
				<anonymousAuthentication enabled="true" />
				<basicAuthentication enabled="false" />
				<windowsAuthentication enabled="false" />
			</authentication>
			<requestFiltering>
				<hiddenSegments>
					<add segment="node_modules" />
					<add segment="iisnode" />
				</hiddenSegments>
			</requestFiltering>
		</security>

		<!-- 2. REGISTRO DEL HANDLER DE IISNODE (SIN REMOVER STATICFILE) -->
		<handlers>
			<add name="iisnode" path="index.js" verb="*" modules="iisnode" />
		</handlers>

		<!-- 3. CONFIGURACIÓN DEL ENTORNO IISNODE -->
		<iisnode
		  loggingEnabled="true"
		  logDirectory="iisnode"
		  debuggingEnabled="false"
		  devErrorsEnabled="true"
		  nodeProcessCommandLine="node.exe" />

		<!-- 4. REGLAS DE REESCRITURA DE URL -->
		<rewrite>
			<rules>
				<!-- Ignorar peticiones a logs de depuración -->
				<rule name="NodeInspector" stopProcessing="true">
					<match url="^index.js\/debug[\/]?" />
				</rule>

				<!-- Permitir que archivos estáticos existentes se sirvan directamente por IIS -->
				<rule name="StaticContent" stopProcessing="true">
					<match url="^.*\.(html|css|js|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$" ignoreCase="true" />
					<action type="None" />
				</rule>

				<!-- Redirigir peticiones dinámicas y API a index.js -->
				<rule name="DynamicContent">
					<conditions>
						<add input="{REQUEST_FILENAME}" matchType="IsFile" negate="True" />
					</conditions>
					<action type="Rewrite" url="index.js" />
				</rule>
			</rules>
		</rewrite>

		<!-- 5. DOCUMENTO DE INICIO POR DEFECTO -->
		<defaultDocument>
			<files>
				<clear />
				<add value="preview.html" />
				<add value="index.html" />
			</files>
		</defaultDocument>

		<directoryBrowse enabled="false" />

	</system.webServer>
</configuration>