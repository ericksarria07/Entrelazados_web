# Copia este archivo como .env y llena los valores reales. NUNCA subas .env a GitHub.
GEMINI_API_KEY=
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
# Cadena larga y aleatoria: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Correo para recuperar contraseñas (opcional). Con Gmail usa una "contraseña de aplicación":
# https://myaccount.google.com/apppasswords  (requiere verificación en 2 pasos)
# Si se dejan vacías, el enlace de recuperación solo aparece en el log (pm2 logs).
# Los correos llegan a cualquier dirección real (Gmail, Hotmail, Yahoo...).
# Para comprobar la configuración: node correo.js tu_correo@gmail.com
EMAIL_USER=
EMAIL_PASS=
# Solo si usas otro proveedor en lugar de Gmail (p. ej. smtp.office365.com y 587)
EMAIL_HOST=
EMAIL_PORT=
# Dirección pública del sitio para los enlaces del correo (opcional), p. ej. http://57.156.69.249:3000
APP_URL=

# ---------------------------------------------------------------- Opcionales
# Límites de intentos (ver limites.js). Si se dejan vacíos se usan estos valores:
# LIMITE_LOGIN=10           intentos FALLIDOS de login por IP cada 15 min
# LIMITE_REGISTRO=5         cuentas nuevas por IP cada hora
# LIMITE_RECUPERACION=5     solicitudes de recuperación por IP cada 15 min
# LIMITE_KAN_MINUTO=10      preguntas a Kan por usuario cada minuto
# LIMITE_KAN_DIA=150        preguntas a Kan por usuario cada día
# LIMITE_API=300            peticiones a /api por IP cada minuto
# LIMITE_FOTOS=20           publicaciones por usuario cada hora
# Solo si se pone nginx delante del servidor (para que los límites vean la IP real):
TRUST_PROXY=
# Otros sitios que pueden usar la API (separados por coma). Vacío = solo este mismo sitio.
CORS_ORIGENES=
# Carpeta de las fotos subidas (por defecto entrelazados-api/uploads)
UPLOADS_DIR=
# Cada cuántos segundos se cierran las subastas vencidas (por defecto 60)
INTERVALO_CIERRE_SUBASTAS_SEG=
# Respaldos (backend/scripts/respaldo.sh): carpeta y días que se conservan
CARPETA_RESPALDOS=
DIAS_RESPALDO=
